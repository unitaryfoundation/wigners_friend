# Quantinuum NEXUS Configuration
# Copy this file to .env and fill in your credentials

# Quantinuum device to use (emulator or hardware)
# Run 'uv run python list_quantinuum_devices.py' to see all available devices
# Available emulator options:
#   - H1-1LE: H1-1 local emulator (for testing)
#   - H2-1LE: H2-1 local emulator (for testing)
#   - H1-Emulator: H1 emulator with noise model
#   - H2-Emulator: H2 emulator with noise model
QUANTINUUM_DEVICE=H1-1LE

# Number of measurement shots (default: 10000)
QUANTINUUM_SHOTS=10000

# Compilation optimization level 0-2 (default: 1)
QUANTINUUM_OPT_LEVEL=1

# NEXUS project name (default: wigners-friend)
QUANTINUUM_PROJECT=GHZ

# ==============================================================================
# QNEXUS AUTHENTICATION (Required)
# ==============================================================================
# You need to authenticate with qNexus before running. Choose one method:
#
# Method 1 (Recommended): Use the qNexus CLI
#   $ uv run qnx login
#   This opens your web browser for secure authentication
#
# Method 2: Set credentials in your .env file
#   Uncomment and fill in your Quantinuum NEXUS credentials:
#
# QNEXUS_EMAIL=your_email@example.com
# QNEXUS_PASSWORD=your_password
#
# Note: If you use Method 2, make sure .env is in .gitignore (it already is)
